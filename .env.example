# SpatialPosters — example environment configuration (copy to .env.local)

# === API Keys (per-request: header x-api-key or query api_key; profile ?u=) ===
# Optional instance fallback for single-user personal deployments:
# SPATIALPOSTERS_TMDB_KEY=your_tmdb_v3_key
# SPATIALPOSTERS_MDBLIST_KEY=your_mdblist_key
# SPATIALPOSTERS_TVDB_API_KEY=your_tvdb_key

# === Storage ===
# KV_REST_API_URL=https://xxx.upstash.io
# KV_REST_API_TOKEN=xxx
# SPATIALPOSTERS_DATA_DIR=/data

# === Render pipeline ===
# SPATIALPOSTERS_MAX_CONCURRENT_RENDERS=4
# SPATIALPOSTERS_RENDER_SLOT_WAIT_MS=15000
# SPATIALPOSTERS_RENDER_TIMEOUT_MS=30000
# SPATIALPOSTERS_CACHE_MAX_MB=150
# SPATIALPOSTERS_CACHE_MAX_ENTRIES=2000

# === Auth & rate limit ===
# SPATIALPOSTERS_ADMIN_TOKEN=supersecret
# SPATIALPOSTERS_ALLOW_DEV_ADMIN=1
# SPATIALPOSTERS_WARMUP_TOKEN=warmup-secret
# SPATIALPOSTERS_RATELIMIT_POSTER_MAX=200
# SPATIALPOSTERS_LOG_LEVEL=info
# SPATIALPOSTERS_LOG_FORMAT=human
# SPATIALPOSTERS_TRUST_PROXY=1
# SPATIALPOSTERS_ALLOWED_HOSTS=example.com

# === Warmup & build ===
# SPATIALPOSTERS_SELF_WARMUP=1
# SPATIALPOSTERS_PUBLIC_INSTANCE=1
# NODE_MAX_OLD_SPACE=384
